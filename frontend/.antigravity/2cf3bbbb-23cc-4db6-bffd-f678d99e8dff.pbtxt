        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (active) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (color === \'critical\') classes += \"bg-critical/20 border-critical text-critical\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    else classes += \"bg-primary/20 border-primary text-primary\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
