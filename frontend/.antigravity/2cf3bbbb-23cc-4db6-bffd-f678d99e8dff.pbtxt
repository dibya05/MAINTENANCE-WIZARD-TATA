        lines {
          text: "      <span className=\"text-xs text-text-muted\">{label} <span className=\"text-text-main ml-1\">({count})</span></span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    </div>"
