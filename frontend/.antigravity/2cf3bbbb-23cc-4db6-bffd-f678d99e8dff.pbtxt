          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "function FilterChip({ label, active, color }) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let classes = \"px-3 py-1.5 rounded-full text-[12px] font-medium border cursor-pointer transition-colors \";"
