# Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local development:
MONGO_URI=

# MongoDB Atlas (production):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/maintenance-wizard?retryWrites=true&w=majority

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Use a long random string in production. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=supersecretkey123_CHANGE_THIS_IN_PRODUCTION

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set this to your deployed frontend URL in production
# FRONTEND_ORIGIN=https://your-app.vercel.app
